{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client"],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
  /**
   * `src/lib/wasm/` is generated by wasm-pack on every build and gitignored.
   * Its emitted .js trips `checkJs` with ~54 implicit-any errors that are not
   * ours to fix and would be overwritten anyway. Excluding it only drops it as
   * a ROOT file: an `import ... from "./wasm/tactistl_wasm.js"` still resolves
   * and type-checks, because TypeScript prefers the sibling generated
   * `tactistl_wasm.d.ts` over the .js, and `skipLibCheck` covers that.
   */
  /**
   * `src/lib/dotpad/vendor/` holds the Dot Inc Web SDK, vendored byte-identical
   * to upstream so it can be re-downloaded and diffed. It is minified
   * third-party JS and trips `checkJs` with ~342 implicit-any errors that are
   * not ours to fix and must not be patched in place. Only the `.js` is
   * excluded, so our hand-written `DotPadSDK-3.0.2.d.ts` is still type-checked
   * as a root file, and an `import ... from "./vendor/DotPadSDK-3.0.2"`
   * resolves to that `.d.ts` rather than the excluded `.js`.
   */
  "exclude": ["src/lib/wasm", "src/lib/dotpad/vendor/*.js"]
}
